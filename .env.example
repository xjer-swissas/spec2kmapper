# Export these variables in your shell before running script.py.
# This file is a template; script.py does not load .env files automatically.
AMOS_PGHOST=localhost
AMOS_PGPORT=5432
AMOS_PGDATABASE=your_database
AMOS_PGUSER=your_user
AMOS_PGPASSWORD=replace_with_your_password

# Set these for the Docker Compose application produced by create_app.py.
POSTGRES_PASSWORD=replace_with_a_strong_password
SECRET_KEY=replace_with_a_random_signing_key
# For running the generated backend outside Docker, also set DATABASE_URL.
