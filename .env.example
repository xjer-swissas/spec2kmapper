# Optional overrides for running the application outside Docker.
DATABASE_URL=postgresql://app_admin:AppSecurePassword2026@localhost:5433/amos_app_db
SECRET_KEY=replace-with-a-long-random-secret
ACCESS_TOKEN_EXPIRE_MINUTES=1440
SEMANTIC_MATCHING=true
